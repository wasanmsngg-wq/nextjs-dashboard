{
  "name": "exercise-tracker",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:contracts",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs tests/migration-contracts.test.mjs tests/local-supabase-guard.test.mjs",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "verify:all": "pnpm db:reset && pnpm verify && pnpm test:e2e && pnpm audit:prod && git diff --check",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "1.3.0",
    "@heroicons/react": "2.2.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@tailwindcss/forms": "0.5.10",
    "antd": "6.5.1",
    "autoprefixer": "10.4.20",
    "clsx": "2.1.1",
    "next": "16.2.12",
    "postcss": "8.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.111.0",
    "vitest": "4.1.10"
  }
}
