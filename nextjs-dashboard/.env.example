# Browser-safe local/staging configuration. Never add service-role credentials.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
APP_ENV=development
RATE_LIMIT_ADAPTER=memory
ERROR_REPORTER_ADAPTER=console

# Production requires the distributed/Sentry adapters and their real
# credentials. Keep these server-only and configure them in the deployment
# platform rather than committing values:
# RATE_LIMIT_ADAPTER=distributed
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# ERROR_REPORTER_ADAPTER=sentry
# SENTRY_DSN=https://public-key@monitoring.example/project-id
